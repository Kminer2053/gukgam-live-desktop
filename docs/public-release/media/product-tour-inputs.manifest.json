  "clips": [
    {
      "file": "voice-01.wav",
      "bytes": 232614,
      "sha256": "9a2fde89520a5dec121e9dd670264b728a0132173f56b9f4b1adf1cf34465ba8",
      "spoken": "바이브코딩 몰라도, 내 챗지피티 계정으로 시작하세요."
    },
    {
      "file": "voice-02.wav",
      "bytes": 162722,
      "sha256": "5ce4ed747915a4098de2f5dfaddfc84fa446314028efa74c6ce910b09773a426",
      "spoken": "키워드 검색으로 원하는 발언을 바로 찾고,"
    },
    {
      "file": "voice-03.wav",
      "bytes": 200420,
      "sha256": "9691e100251a6073f58a51d0d2ec77f55feb7f967d7bb413d82dc3d8c2bf805e",
      "spoken": "시간 막대를 움직여 필요한 대목으로 빠르게 이동하세요."
    },
    {
      "file": "voice-04.wav",
      "bytes": 172866,
      "sha256": "490f7bb7519b65eebe87bedc70e61ecae773cc96184067eb311ce5c087aa4915",
      "spoken": "질의별 자동 요약은 질의자별로 모아 보세요."
    },
    {
      "file": "voice-05.wav",
      "bytes": 188522,
      "sha256": "347a21dfecdffa65e05c27d4cfa665bb6c186bf4eef0e56c0cc7424e5085b667",
      "spoken": "자료 요구와 제출 약속도 한곳에서 관리하고,"
    },
    {
      "file": "voice-06.wav",
      "bytes": 150160,
      "sha256": "84bd953d6d5cc855b76c14859e0a154ff6665c28c44f6a290dd93474d6190ea8",
      "spoken": "정리한 기록은 보고서로 내보내세요."
    },
    {
      "file": "voice-07.wav",
      "bytes": 262158,
      "sha256": "57695f5d6da9463638c97803f64984ef4dabeca6f36297d1ff9674ef4764bc2d",
      "spoken": "바이브코딩 몰라도, 내 지피티 계정으로 국정감사 회의록 정리."
    }
  ],
